#!/bin/sh
# ws-map — SessionStart context for a workspace of independent git repos.
#   Root session  -> workspace rules + one line per repo (root = ws_root, or auto-detected).
#   Any git repo  -> the repo's AGENTS.md when it has no CLAUDE.md.
#   Elsewhere     -> nothing.
# POSIX sh, needs only git. Local git only (no network). Always exits 0.

MAX_REPOS=200
AGENTS_MAX_LINES=300

canonical() { (cd "$1" 2>/dev/null && pwd -P); }

# Configured paths may arrive with a literal, unexpanded "~"; expand it by hand.
# shellcheck disable=SC2088  # matching the literal "~" text is the point here
expand_tilde() {
  case "$1" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s/%s' "$HOME" "${1#\~/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Fast path: read plain files in a regular .git dir; fall back to git otherwise
# (worktrees with a .git file, reftable repos, missing symref).
current_branch() {
  head_file="$1/.git/HEAD"
  if [ -f "$head_file" ]; then
    read -r head < "$head_file"
    case "$head" in
      "ref: refs/heads/"*) printf '%s' "${head#ref: refs/heads/}"; return ;;
      [0-9a-f]*) printf '(detached %.7s)' "$head"; return ;;
    esac
  fi
  branch=$(git -C "$1" branch --show-current 2>/dev/null)
  [ -n "$branch" ] && { printf '%s' "$branch"; return; }
  printf '(detached %s)' "$(git -C "$1" rev-parse --short HEAD 2>/dev/null)"
}

default_branch() {
  symref="$1/.git/refs/remotes/origin/HEAD"
  if [ -f "$symref" ]; then
    read -r ref < "$symref"
    case "$ref" in
      "ref: refs/remotes/origin/"*) printf '%s' "${ref#ref: refs/remotes/origin/}"; return ;;
    esac
  fi
  ref=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -n "$ref" ]; then printf '%s' "${ref#*/}"; return; fi
  for b in main master; do
    if git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$b"; then printf '%s' "$b"; return; fi
  done
  printf '?'
}

repo_line() {
  name=$(basename "$1")
  branch=$(current_branch "$1")
  default=$(default_branch "$1")
  mark=""
  if [ "$default" != "?" ] && [ "$branch" != "$default" ]; then mark=" ★ (default: $default)"; fi
  last=$(git -C "$1" log -1 --format=%cs 2>/dev/null)
  printf -- '- %s | %s%s | %s\n' "$name" "$branch" "$mark" "${last:--}"
}

root_mode() {
  rules="$(dirname "$0")/../rules/workspace.md"
  if [ -f "$rules" ]; then cat "$rules"; printf '\n'; fi
  count=0
  lines=""
  for dir in "$1"/*/; do
    dir=${dir%/}
    [ -e "$dir/.git" ] || continue
    count=$((count + 1))
    [ "$count" -le "$MAX_REPOS" ] || continue
    lines="$lines$(repo_line "$dir")
"
  done
  printf '## Workspace map (%s) — %s repos\n' "$1" "$count"
  printf '%s' "$lines"
  if [ "$count" -gt "$MAX_REPOS" ]; then printf '… and %s more\n' $((count - MAX_REPOS)); fi
}

repo_mode() {
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -f "$top/AGENTS.md" ] || return 0
  [ -f "$top/CLAUDE.md" ] && return 0
  printf "## This repo's AGENTS.md (%s/AGENTS.md)\n" "$top"
  head -n "$AGENTS_MAX_LINES" "$top/AGENTS.md"
}

# A workspace = a dir that is not inside a git repo and has >= 2 direct child repos.
is_workspace() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 && return 1
  found=0
  for dir in "$1"/*/; do
    [ -e "${dir%/}/.git" ] || continue
    found=$((found + 1))
    [ "$found" -ge 2 ] && return 0
  done
  return 1
}

# Root = configured ws_root (plugin option, then WS_ROOT); unconfigured -> auto-detect the project dir.
resolve_root() {
  configured="${CLAUDE_PLUGIN_OPTION_WS_ROOT:-${WS_ROOT:-}}"
  if [ -n "$configured" ]; then canonical "$(expand_tilde "$configured")"; return 0; fi
  is_workspace "$1" && printf '%s' "$1"
  return 0
}

main() {
  proj=$(canonical "$(expand_tilde "${CLAUDE_PROJECT_DIR:-$PWD}")") || return 0
  [ -n "$proj" ] || return 0
  root=$(resolve_root "$proj")
  if [ -n "$root" ] && [ "$proj" = "$root" ]; then root_mode "$root"; return 0; fi
  repo_mode "$proj"
}

main
exit 0
